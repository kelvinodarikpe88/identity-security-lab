{
  "name": "Account Compromise Response",
  "version": "1.0",
  "description": "Starter automation workflow for investigating and containing suspected identity compromise.",
  "trigger": {
    "type": "security_alert",
    "category": "account_compromise"
  },
  "actions": [
    {
      "name": "collect_identity_context",
      "status": "planned"
    },
    {
      "name": "revoke_sessions",
      "status": "planned"
    },
    {
      "name": "reset_credentials",
      "status": "approval_required"
    },
    {
      "name": "notify_security_team",
      "status": "planned"
    }
  ],
  "evidence": [
    "user",
    "source_ip",
    "timestamp",
    "risk_detection",
    "authentication_result"
  ]
}
