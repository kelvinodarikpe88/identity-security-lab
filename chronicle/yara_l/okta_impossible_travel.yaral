rule okta_impossible_travel {

  meta:
    author = "Security Engineering"
    description = "Starter detection for suspicious geographically inconsistent Okta authentication activity"
    severity = "MEDIUM"

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user

  match:
    $user over 1h

  condition:
    #login > 1
}
